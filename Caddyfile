# ==============================================================================
#  NewConstuc.FIRM - Caddy Web Server Configuration (Laravel 10)
# ==============================================================================
#
#  Quick Start:
#    1. Start PHP FastCGI (Windows):  php-cgi.exe -b 127.0.0.1:9000
#       Start PHP-FPM (Linux):        sudo systemctl start php8.1-fpm
#    2. Run Caddy:                   caddy run --config Caddyfile
#
#  Trusted proxy note:
#    Caddy terminates TLS / forwards X-Forwarded-Proto, X-Forwarded-For,
#    X-Forwarded-Host and X-Forwarded-Port to PHP. Laravel must trust those
#    headers via App\Http\Middleware\TrustProxies (TRUSTED_PROXIES env,
#    defaults to '*'). Without it, isSecure()/url()/asset()/secure cookies
#    break behind Caddy (login loops, mixed content, http redirect loops).
#
#  Docker/FrankenPHP note:
#    This file is for stock Caddy + php-cgi/php-fpm local dev.
#    Docker (FrankenPHP) uses Caddyfile.frankenphp instead - see Dockerfile.
#
# ==============================================================================

# Trust private-range proxies (Docker, LAN, outer TLS terminator) so Caddy
# correctly resolves client_ip from X-Forwarded-For before passing to PHP.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# ------------------------------------------------------------------------------
# 1. Local Development Server (HTTP on Port 8000)
# ------------------------------------------------------------------------------
:8000, http://localhost:8000, http://127.0.0.1:8000 {
	# Set public document root for Laravel
	root * ./public

	# Enable high-performance compression
	encode zstd gzip

	# Security Headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Deny access to sensitive files and directories
	@blocked {
		path */.*
		path /composer.*
		path /package.*
		path /artisan
		path /storage/logs/*
		path /database/*
		path /config/*
		path /app/*
		path /bootstrap/*
		path /routes/*
	}
	respond @blocked 404

	# Route all dynamic PHP requests through FastCGI
	# On Windows: php-cgi listening on 127.0.0.1:9000
	# On Linux: unix//run/php/php8.1-fpm.sock
	php_fastcgi 127.0.0.1:9000

	# Serve static assets (CSS, JS, images, fonts, uploads)
	file_server

	# Static asset caching headers
	@static {
		file
		path *.css *.js *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.eot *.webp
	}
	header @static Cache-Control "public, max-age=31536000, immutable"
}

# ------------------------------------------------------------------------------
# 2. Local HTTPS Server (Optional: Automatic Local TLS on https://localhost:8443)
# ------------------------------------------------------------------------------
# https://localhost:8443 {
#     tls internal
#     root * ./public
#     encode zstd gzip
#
#     php_fastcgi 127.0.0.1:9000
#     file_server
# }

# ------------------------------------------------------------------------------
# 3. Production Deployment Example (Automatic Free SSL via Let's Encrypt / ZeroSSL)
# ------------------------------------------------------------------------------
# stbilfrid.site, www.stbilfrid.site {
#     root * /var/www/NewConstuc.FIRM/public
#     encode zstd gzip
#
#     # If Caddy itself sits behind another proxy/CDN, trust it so
#     # X-Forwarded-Proto/For from the outer terminator is honoured.
#     # Otherwise the global `trusted_proxies static private_ranges` above
#     # is sufficient for direct Let's Encrypt deployments.
#     # trusted_proxies static private_ranges
#
#     # Linux PHP-FPM socket
#     php_fastcgi unix//run/php/php8.1-fpm.sock
#     file_server
#
#     log {
#         output file /var/log/caddy/newconstuc_access.log
#     }
# }
